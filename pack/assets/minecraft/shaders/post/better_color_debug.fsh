#version 330
#extension GL_ARB_separate_shader_objects : require

// GENERE par shader_test/gen_shaders.py — ne pas editer a la main.
// Variante DEBUG : visualise quels pixels sont detectes comme couleurs de map.
// Detection = egalite 8-bit STRICTE avec les 244 couleurs map a l'ecran
// (fullbright / glow frame), par RECHERCHE BINAIRE sur cles packees
// (r<<16|g<<8|b) triees : <=8 iterations par pixel (la boucle lineaire de
// 244 faisait chuter les fps de ~2/3). Un pixel voile par le fog ou assombri
// ne matche plus et reste tel quel (degradation propre).

uniform sampler2D InSampler;

layout(location = 0) out vec4 fragColor;

const int VMC_N = 244;
const int VMC_KEY[VMC_N] = int[VMC_N](
    16640, 22272, 27136, 29214, 31744, 39208, 47922, 55610,
    679750, 737862, 855309, 950109, 1005662, 1118481, 1153906, 1207411,
    1248008, 1356933, 1381653, 1474182, 1644825, 1707787, 1779806, 1971474,
    1985354, 2036237, 2171271, 2372989, 2430480, 2573191, 2628114, 2628632,
    2629680, 2631720, 2632470, 2638673, 2647138, 2900377, 2955040, 2960820,
    3026992, 3149071, 3175280, 3220254, 3308152, 3361970, 3421236, 3431092,
    3482392, 3484480, 3487029, 3488029, 3496300, 3549211, 3554588, 3556123,
    3559794, 3618780, 3746083, 3837580, 3866880, 3881289, 3881787, 3940139,
    4014144, 4157148, 4198676, 4204078, 4210943, 4233878, 4270878, 4273487,
    4276545, 4277796, 4287876, 4399454, 4413519, 4415005, 4418573, 4467993,
    4605510, 4667443, 4732196, 4739621, 4741412, 4746392, 4859189, 4882687,
    4923160, 4931366, 4935503, 4993571, 4996700, 5000268, 5001770, 5013401,
    5120307, 5123641, 5177600, 5182745, 5191976, 5196897, 5197647, 5225655,
    5315355, 5329233, 5515305, 5516051, 5526663, 5647422, 5649214, 5658198,
    5658721, 5725276, 5783852, 5789784, 5792813, 5795116, 5801146, 5844093,
    5862761, 5864743, 5869585, 5979170, 6035741, 6085589, 6170738, 6245189,
    6291712, 6315383, 6316128, 6440467, 6560025, 6564384, 6575154, 6579300,
    6704179, 6717235, 6724056, 6780213, 6827076, 6896972, 6897227, 6908265,
    6966326, 7087140, 7105644, 7157401, 7180417, 7182640, 7188501, 7232853,
    7293482, 7340544, 7353911, 7354649, 7367818, 7368816, 7368884, 7488283,
    7494733, 7566977, 7625812, 7697781, 7960859, 8008487, 8014168, 8087102,
    8205720, 8336979, 8339378, 8365974, 8368696, 8375321, 8405847, 8407901,
    8476209, 8543810, 8551254, 8609049, 8662060, 8683048, 8684676, 8724770,
    8847360, 8874850, 8881537, 8882055, 8996383, 9060931, 9079516, 9211020,
    9277598, 9321518, 9402184, 9474192, 9665649, 9715553, 9787244, 9923917,
    9984292, 9993063, 10040115, 10043834, 10066329, 10441252, 10505550, 10514975,
    10526975, 10592548, 10692906, 10791096, 10987431, 11164020, 11250603, 11445363,
    11577398, 11685080, 11796480, 11835530, 11841964, 11842740, 12217644, 12223780,
    12228222, 12398641, 12961068, 13092807, 13659534, 13742497, 14010764, 14142786,
    14188339, 14200723, 14417920, 14473683, 14474460, 15066419, 15892389, 16247203,
    16445005, 16711680, 16776437, 16777215
);

// Renvoie l'index palette de la cle, ou -1.
int vmcFind(int key) {
    int lo = 0, hi = VMC_N - 1;
    while (lo <= hi) {
        int mid = (lo + hi) >> 1;
        int k = VMC_KEY[mid];
        if (k == key) return mid;
        if (k < key) lo = mid + 1; else hi = mid - 1;
    }
    return -1;
}

void main() {
    vec4 color = texelFetch(InSampler, ivec2(gl_FragCoord.xy), 0);
    ivec3 c = ivec3(round(color.rgb * 255.0));
    int i = vmcFind((c.r << 16) | (c.g << 8) | c.b);
    fragColor = i >= 0
        ? vec4(1.0, 0.0, 1.0, color.a)        // detecte -> magenta
        : vec4(color.rgb * 0.35, color.a);    // le reste assombri
}
