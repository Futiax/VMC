#version 330
#extension GL_ARB_separate_shader_objects : require

// GENERE par gen_dct.py -- ne pas editer a la main.
// Passe idct : cible = le canva (16 SX x 16 SY), un fragment par pixel (ligne 0 = haut). 2e moitie de
// l'IDCT (somme sur v de B[v][y] t[v][x]) pour Y, Cb et Cr, puis YCbCr pleine echelle (JPEG) -> RGB.

uniform sampler2D RowsSampler;

layout(location = 0) out vec4 fragColor;

const float DM[64] = float[64](0.3535533905932738, 0.3535533905932738, 0.3535533905932738, 0.3535533905932738, 0.3535533905932738, 0.3535533905932738, 0.3535533905932738, 0.3535533905932738, 0.4903926402016152, 0.4157348061512726, 0.27778511650980114, 0.09754516100806417, -0.0975451610080641, -0.277785116509801, -0.4157348061512727, -0.4903926402016152, 0.46193976625564337, 0.19134171618254492, -0.19134171618254486, -0.46193976625564337, -0.4619397662556434, -0.19134171618254517, 0.191341716182545, 0.46193976625564326, 0.4157348061512726, -0.0975451610080641, -0.4903926402016152, -0.2777851165098011, 0.2777851165098009, 0.4903926402016152, 0.09754516100806439, -0.41573480615127256, 0.3535533905932738, -0.35355339059327373, -0.35355339059327384, 0.3535533905932737, 0.35355339059327384, -0.35355339059327334, -0.35355339059327356, 0.3535533905932733, 0.27778511650980114, -0.4903926402016152, 0.09754516100806415, 0.41573480615127273, -0.41573480615127256, -0.09754516100806401, 0.4903926402016153, -0.27778511650980076, 0.19134171618254492, -0.4619397662556434, 0.46193976625564326, -0.19134171618254495, -0.19134171618254528, 0.46193976625564337, -0.4619397662556432, 0.19134171618254478, 0.09754516100806417, -0.2777851165098011, 0.41573480615127273, -0.4903926402016153, 0.4903926402016152, -0.4157348061512725, 0.27778511650980076, -0.09754516100806429);    // a(u) cos((2x + 1) u pi / 16), [u * 8 + x]
const float DTC[128] = float[128](0.3535533905932738, 0.3535533905932738, 0.3535533905932738, 0.3535533905932738, 0.3535533905932738, 0.3535533905932738, 0.3535533905932738, 0.3535533905932738, 0.3535533905932738, 0.3535533905932738, 0.3535533905932738, 0.3535533905932738, 0.3535533905932738, 0.3535533905932738, 0.3535533905932738, 0.3535533905932738, 0.49759236333609846, 0.4784701678661044, 0.4409606321741775, 0.3865052266813685, 0.31719664208182274, 0.2356983684129989, 0.14514233862723117, 0.049008570164780385, -0.04900857016478032, -0.14514233862723108, -0.23569836841299885, -0.3171966420818227, -0.3865052266813685, -0.44096063217417747, -0.4784701678661044, -0.4975923633360984, 0.4903926402016152, 0.4157348061512726, 0.27778511650980114, 0.09754516100806417, -0.0975451610080641, -0.277785116509801, -0.4157348061512727, -0.4903926402016152, -0.4903926402016152, -0.41573480615127273, -0.2777851165098011, -0.09754516100806433, 0.09754516100806415, 0.2777851165098009, 0.4157348061512726, 0.49039264020161516, 0.4784701678661044, 0.31719664208182274, 0.049008570164780385, -0.23569836841299885, -0.44096063217417747, -0.49759236333609846, -0.38650522668136855, -0.14514233862723122, 0.14514233862723103, 0.38650522668136833, 0.49759236333609846, 0.4409606321741775, 0.235698368412999, -0.04900857016477998, -0.3171966420818224, -0.47847016786610425, 0.46193976625564337, 0.19134171618254492, -0.19134171618254486, -0.46193976625564337, -0.4619397662556434, -0.19134171618254517, 0.191341716182545, 0.46193976625564326, 0.46193976625564337, 0.19134171618254522, -0.19134171618254495, -0.4619397662556432, -0.46193976625564337, -0.19134171618254528, 0.1913417161825449, 0.4619397662556432, 0.4409606321741775, 0.049008570164780385, -0.3865052266813685, -0.47847016786610447, -0.14514233862723122, 0.3171966420818228, 0.49759236333609846, 0.235698368412999, -0.23569836841299874, -0.49759236333609846, -0.3171966420818227, 0.14514233862723133, 0.47847016786610425, 0.38650522668136883, -0.04900857016477986, -0.44096063217417736, 0.4157348061512726, -0.0975451610080641, -0.4903926402016152, -0.2777851165098011, 0.2777851165098009, 0.4903926402016152, 0.09754516100806439, -0.41573480615127256, -0.4157348061512728, 0.0975451610080636, 0.4903926402016152, 0.27778511650980126, -0.27778511650980076, -0.4903926402016153, -0.097545161008065, 0.415734806151272, 0.3865052266813685, -0.23569836841299885, -0.47847016786610447, 0.049008570164780045, 0.49759236333609846, 0.14514233862723128, -0.4409606321741774, -0.3171966420818227, 0.31719664208182236, 0.44096063217417764, -0.14514233862723128, -0.49759236333609846, -0.04900857016478135, 0.47847016786610447, 0.2356983684129992, -0.38650522668136783);  // la meme en x = pixel / 2 - 0,25, [u * 16 + pixel]

vec2 pairAt(ivec2 mb, int col, int r) {
    ivec4 e = ivec4(round(texelFetch(RowsSampler, ivec2(mb.x * 64 + col, mb.y * 4 + r), 0) * 255.0));
    ivec2 v = ivec2(e.r | (e.g << 8), e.b | (e.a << 8));
    v -= ivec2(greaterThanEqual(v, ivec2(32768))) * 65536;
    return vec2(v) / 16.0;
}

void main() {
    ivec2 f = ivec2(gl_FragCoord.xy);
    ivec2 mb = f / 16, l = f - mb * 16;
    int b = (l.y / 8) * 2 + l.x / 8;
    ivec2 xy = l % 8;
    float y = 0.0;
    for (int r = 0; r < 4; r++) {
        vec2 t = pairAt(mb, b * 8 + xy.x, r);
        y += DM[2 * r * 8 + xy.y] * t.x + DM[(2 * r + 1) * 8 + xy.y] * t.y;
    }
    float c[2];
    for (int k = 0; k < 2; k++) {
        c[k] = 0.0;
        for (int r = 0; r < 4; r++) {
            vec2 t = pairAt(mb, 32 + k * 16 + l.x, r);
            c[k] += DTC[2 * r * 16 + l.y] * t.x + DTC[(2 * r + 1) * 16 + l.y] * t.y;
        }
    }
    y += 128.0;
    vec3 rgb = vec3(y + 1.402 * c[1], y - 0.344136 * c[0] - 0.714136 * c[1], y + 1.772 * c[0]);
    fragColor = vec4(clamp(rgb, 0.0, 255.0) / 255.0, 1.0);
}
