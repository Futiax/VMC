// Renvoie l'index palette de la cle, ou -1.
int vmcFind(int key) {
    int lo = 0, hi = VMC_N - 1;
    while (lo <= hi) {
        int mid = (lo + hi) >> 1;
        int k = VMC_KEY[mid];
        if (k == key) return mid;
        if (k < key) lo = mid + 1; else hi = mid - 1;
    }
    return -1;
}
